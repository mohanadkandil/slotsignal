FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends tzdata ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 monitor && useradd --uid 10001 --gid monitor --create-home monitor
WORKDIR /app
COPY monitor.py telegram_client.py server.py fly_start.py config.json ./
ENV PYTHONUNBUFFERED=1 ALERT_DATA_DIR=/data ALERT_CHANNELS=telegram ALERT_HEALTH_PORT=8080
CMD ["python", "fly_start.py"]
